generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Domain lifecycle enums. Labels match the previous TEXT values exactly.
// PayPal webhook eventType stays String so unknown provider events can be persisted and ignored.

enum UserRole {
  ADMIN
  SELLER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum ListingStatus {
  ACTIVE
  SOLD
  RESERVED
  CANCELED
}

enum ClaimStatus {
  IN_PROGRESS
  COMPLETED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PaymentProvider {
  PAYPAL
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RefundReason {
  UNFULFILLABLE_CAPTURE
}

enum SellerLedgerEntryType {
  PAYMENT_CREDIT
  REFUND_COMPENSATION
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller               Seller?
  orders               Order[]               @relation("CustomerOrders")
  orderIdempotencyKeys OrderIdempotencyKey[]
  reviews              Review[]
  refreshTokens        RefreshToken[]
  favorites            Favorite[]
}

// Pending sign-up: user is created only after email verification (code confirmation)
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole // CUSTOMER | SELLER at registration; ADMIN is seed-only
  storeName    String? // required when role = SELLER
  code         String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Seller {
  id             String   @id @default(cuid())
  userId         String   @unique
  storeName      String
  commissionRate Decimal  @default(0.1)
  /// Materialized projection of SUM(PAID SellerTransaction.netAmount).
  /// SellerTransaction is the source of truth if they disagree (ADR 0011).
  balance        Decimal  @default(0)
  rating         Float    @default(0)
  isApproved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings     Listing[]
  orderItems   OrderItem[]
  transactions SellerTransaction[]
}

model Product {
  id         String   @id @default(cuid())
  game       String // CS2, CSGO, etc. - prepared for multi-game
  weapon     String
  skinName   String
  rarity     String
  exterior   String // Factory New, Minimal Wear, Field-Tested, Well-Worn, Battle-Scarred
  collection String?
  imageUrl   String?
  isStattrak Boolean  @default(false)
  isSouvenir Boolean  @default(false)
  /// Canonical Steam / cs2.sh market_hash_name. Null on hand-seeded demo rows.
  marketHashName String? @unique
  /// cs2.sh USD ask for display/reference only. Not checkout or ledger currency (ADR 0014).
  referencePriceUsd Decimal?
  /// Schema generation_id from the last successful cs2.sh import.
  cs2ShGenerationId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listings Listing[]
  reviews  Review[]

  @@index([game])
  @@index([weapon])
  @@index([exterior])
  @@index([rarity])
  @@index([isStattrak])
  @@index([game, weapon, exterior, isStattrak])
  @@index([createdAt, id])
}

model Order {
  id              String   @id @default(cuid())
  customerId      String
  totalAmount     Decimal
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paypalOrderId   String?  @unique
  trackingCode    String?
  trackingCarrier String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer               User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  items                  OrderItem[]
  transactions           SellerTransaction[]
  creationIdempotencyKey OrderIdempotencyKey?
  paymentLink            PaymentLink?
  refunds                Refund[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus, status, updatedAt])
}

/// Durable full-BRL technical refund obligation. PayPal execution is deliberately
/// outside this model task; provider + providerCaptureId is the economic identity.
model Refund {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider @default(PAYPAL)
  providerCaptureId String
  providerRefundId  String?
  amount            Decimal
  reason            RefundReason    @default(UNFULFILLABLE_CAPTURE)
  status            RefundStatus    @default(PENDING)
  failureReason     String?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerTransactions SellerTransaction[]

  @@unique([provider, providerCaptureId])
  @@unique([provider, providerRefundId])
  @@index([orderId])
  @@index([status, updatedAt])
}

model PaymentLink {
  orderId       String   @id
  paypalOrderId String?  @unique
  approvalUrl   String?
  status        ClaimStatus @default(IN_PROGRESS)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderIdempotencyKey {
  id          String   @id @default(cuid())
  customerId  String
  key         String
  requestHash String
  status      ClaimStatus @default(IN_PROGRESS)
  orderId     String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([customerId])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        PaymentProvider    @default(PAYPAL)
  externalEventId String
  eventType       String
  status          WebhookEventStatus @default(RECEIVED)
  orderId         String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  failureReason   String?

  @@unique([provider, externalEventId])
  @@index([orderId])
  @@index([status])
}

model Listing {
  id                   String    @id @default(cuid())
  productId            String
  sellerId             String
  floatValue           Decimal
  pattern              Int?
  price                Decimal
  /// Checkout denomination. PostgreSQL constrains this to BRL (ADR 0022).
  currency             String    @default("BRL")
  status               ListingStatus @default(ACTIVE)
  tradeLockUntil       DateTime?
  reservedAt           DateTime?
  reservationExpiresAt DateTime?
  reservedByOrderId    String?
  steamAssetId         String?
  createdAt            DateTime  @default(now())
  soldAt               DateTime?
  updatedAt            DateTime  @updatedAt

  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller       Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]
  orderItems   OrderItem[]
  favorites    Favorite[]

  @@index([productId])
  @@index([price])
  @@index([floatValue])
  @@index([sellerId])
  @@index([productId, status])
  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@index([status, price, id])
  @@index([status, floatValue, id])
  @@index([status, reservationExpiresAt])
  @@index([reservedByOrderId])
}

/// Account-owned saved listing. Unique (userId, listingId). Does not reserve,
/// buy, or change Listing status (SPEC-0004 / issue #106).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  listingId String
  oldPrice  Decimal
  newPrice  Decimal
  changedAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([changedAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  listingId     String
  sellerId      String
  priceSnapshot Decimal

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([listingId])
  @@index([sellerId])
}

/// Authoritative append-only seller ledger. Amounts are BRL and signed by entry
/// type. Seller.balance is a projection of all applied (PAID) net movements.
model SellerTransaction {
  id               String                @id @default(cuid())
  sellerId         String
  orderId          String
  refundId         String?
  entryType        SellerLedgerEntryType @default(PAYMENT_CREDIT)
  /// Stable local economic-event identity: orderId for credits, refundId for compensation.
  economicEventId  String
  grossAmount      Decimal
  commissionAmount Decimal
  netAmount        Decimal
  /// Applied credits and compensations are PAID ledger movements. REFUNDED is
  /// payment lifecycle state and is not used to overwrite ledger history.
  status           PaymentStatus         @default(PENDING)
  createdAt        DateTime              @default(now())

  seller Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund Refund? @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([sellerId, entryType, economicEventId])
  @@index([sellerId])
  @@index([orderId])
  @@index([refundId])
  @@index([sellerId, status])
}

model Review {
  id        String   @id @default(cuid())
  productId String // Reviews are for the product catalog, not individual listings
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

// Issued refresh tokens (allowlist). Each login starts a family. Rotation marks
// the previous row used and inserts a successor in the same family. Presenting a
// used or unknown token in a live family revokes every row in that family.
// Do not store the raw JWT — only jti / familyId. See docs/adr/0015-refresh-token-families.md.
model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  familyId  String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
}

// Per-email login throttle (issue #57). Unknown emails are tracked too so
// enumeration does not skip the delay. nextAllowedAt is the progressive delay.
model LoginThrottle {
  emailNormalized String    @id
  failedCount     Int       @default(0)
  lastFailedAt    DateTime
  nextAllowedAt   DateTime?
  updatedAt       DateTime  @updatedAt
}

// Append-only audit trail for sensitive mutations (issue #42).
// Access: ADMIN-only (`GET /admin/audit-logs`). Non-admin callers receive 401/403.
// Retention: keep rows for 365 days. There is no Redis/SQS/cron purge worker;
// `createdAt` is indexed so an operator can delete aged rows with a one-shot SQL
// job later. Do not store passwords, JWT/refresh tokens, PayPal secrets, or
// full payment payloads — writers persist field-level non-sensitive diffs and
// the repository redacts known secret keys as defense in depth.
// No FK to User: the trail must outlive account deletion; actorId is informational.
model AuditLog {
  id           String    @id @default(cuid())
  actorId      String?
  actorRole    UserRole?
  action       String
  resourceType String
  resourceId   String
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId])
}

// Transactional outbox (issue #46 / ADR 0012). Inserted in the same local
// PostgreSQL transaction as the domain mutation. PayPal HTTP stays outside.
// Payload is non-secret JSON (order ids, statuses). No tokens, passwords,
// or provider secrets. Unique (type, aggregateId) makes a second insert for
// the same confirmation a constraint violation rather than a duplicate event.
model OutboxEvent {
  id          String            @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now())
  claimedAt   DateTime?
  lastError   String?
  createdAt   DateTime          @default(now())

  @@unique([type, aggregateId])
  @@index([status, availableAt])
  @@index([aggregateId])
}
